# Shared by both apps. The per-app formatter still wins inside its own folder.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown, so they stay.
trim_trailing_whitespace = false
