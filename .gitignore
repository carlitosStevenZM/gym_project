# Secrets. Nothing here is ever committed, in either app.
.env
.env.*
!.env.example
*.pem
*.key

# backend: Python, FastAPI
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# mobile: React Native, Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
.metro-health-check*
# android/ and ios/ are ignored, decided when the client was set up: the app runs
# through Expo Go and the native folders are generated by prebuild. The rule lives
# in apps/mobile/.gitignore, which is what actually applies to them.

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
