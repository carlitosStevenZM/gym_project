# Secrets. Nothing here is ever committed, in either app.
.env
.env.*
!.env.example
*.pem
*.key

# backend: Python, FastAPI
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# mobile: React Native, Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
.metro-health-check*
# android/ and ios/ are NOT ignored on purpose. Expo generates them with
# prebuild, and whether they are committed depends on the workflow we end up
# using. Decide it when the client is set up, and write the decision down.

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
